generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  customer
  rider
  admin

  @@map("user_role")
}

enum UserStatus {
  active
  suspended
  deactivated

  @@map("user_status")
}

enum AccountType {
  standard
  business

  @@map("user_account_type")
}

/// A community the customer lives in. Extended and outside-area places are
/// delivery zones, not account communities.
enum Community {
  igbesa
  lusada
  ketu

  @@map("user_community")
}

/// Phone format (E.164) and trimmed names are also enforced by CHECK
/// constraints in the migrations, which Prisma cannot express in the schema.
/// Role and status are server-owned.
model User {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone       String      @unique @db.VarChar(16)
  name        String?     @db.VarChar(80)
  community   Community?
  accountType AccountType @default(standard) @map("account_type")
  role        UserRole    @default(customer)
  status      UserStatus  @default(active)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders             Order[]             @relation("OrderCustomer")
  quotes             Order[]             @relation("OrderQuotedBy")
  priceRuleChanges   PriceRuleChange[]
  auditEvents        AuditEvent[]
  idempotencyRecords IdempotencyRecord[]

  @@map("users")
}

enum PricingComponent {
  standard_zone
  special_pickup
  errand

  @@map("pricing_component")
}

enum QuoteMode {
  automatic
  manual

  @@map("quote_mode")
}

enum PricingStatus {
  auto
  pending_manual_quote
  manual_quoted

  @@map("pricing_status")
}

enum ServiceType {
  standard
  special_pickup
  errand

  @@map("service_type")
}

/// A community in the corridor, an extended Agbara movement, or outside the
/// service area. Zone tiers are derived from a pair of places, not stored here.
enum Place {
  igbesa
  lusada
  ketu
  extended
  outside

  @@map("place")
}

enum ZoneTier {
  A
  B
  C
  extended
  outside_area

  @@map("zone_tier")
}

enum SpecialPickupTier {
  local
  nearby
  extended
  outside_area

  @@map("special_pickup_tier")
}

enum ErrandTier {
  simple
  moderate
  complex

  @@map("errand_tier")
}

/// Live price list. Amounts are whole kobo. Automatic tiers store a charge.
/// Manual tiers store no charge and a per-leg minimum. The order floor is the
/// sum of the automatic charges and those minimums. Editing a row does not
/// change orders already priced; each edit is recorded on PriceRuleChange.
model PriceRule {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  component   PricingComponent
  tier        String           @db.VarChar(32)
  amountKobo  Int?             @map("amount_kobo")
  minimumKobo Int?             @map("minimum_kobo")
  quoteMode   QuoteMode        @map("quote_mode")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  changes     PriceRuleChange[]

  @@unique([component, tier])
  @@map("price_rules")
}

/// Who changed a live price, what it was, and what it became.
model PriceRuleChange {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleId         String           @map("rule_id") @db.Uuid
  rule           PriceRule        @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  component      PricingComponent
  tier           String           @db.VarChar(32)
  actorId        String           @map("actor_id") @db.Uuid
  actor          User             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  oldQuoteMode   QuoteMode        @map("old_quote_mode")
  oldAmountKobo  Int?             @map("old_amount_kobo")
  oldMinimumKobo Int?             @map("old_minimum_kobo")
  newQuoteMode   QuoteMode        @map("new_quote_mode")
  newAmountKobo  Int?             @map("new_amount_kobo")
  newMinimumKobo Int?             @map("new_minimum_kobo")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ruleId])
  @@index([actorId])
  @@map("price_rule_changes")
}

/// Boxes the server uses to classify a coordinate. Outside is any point none
/// of these contain. Editing a box does not reclassify orders already priced.
model ServiceArea {
  place        Place    @id
  minLatitude  Float    @map("min_latitude")
  maxLatitude  Float    @map("max_latitude")
  minLongitude Float    @map("min_longitude")
  maxLongitude Float    @map("max_longitude")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("service_areas")
}

/// Coordinates are the points classified at pricing time. Places, component
/// amounts, totalKobo and minimumTotalKobo are that classification and are
/// not recomputed when prices or areas change.
model Order {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String  @map("customer_id") @db.Uuid
  customer   User    @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  quotedById String? @map("quoted_by_id") @db.Uuid
  quotedBy   User?   @relation("OrderQuotedBy", fields: [quotedById], references: [id], onDelete: Restrict)

  serviceType      ServiceType @map("service_type")
  pickupPlace      Place?      @map("pickup_place")
  destinationPlace Place?      @map("destination_place")
  collectionPlace  Place?      @map("collection_place")
  errandTier       ErrandTier? @map("errand_tier")

  pickupLatitude       Float? @map("pickup_latitude")
  pickupLongitude      Float? @map("pickup_longitude")
  destinationLatitude  Float? @map("destination_latitude")
  destinationLongitude Float? @map("destination_longitude")
  collectionLatitude   Float? @map("collection_latitude")
  collectionLongitude  Float? @map("collection_longitude")

  pricingStatus            PricingStatus      @map("pricing_status")
  zoneTier                 ZoneTier?          @map("zone_tier")
  zoneAmountKobo          Int?               @map("zone_amount_kobo")
  specialPickupTier        SpecialPickupTier? @map("special_pickup_tier")
  specialPickupAmountKobo Int?               @map("special_pickup_amount_kobo")
  errandAmountKobo        Int?               @map("errand_amount_kobo")
  totalKobo               Int?               @map("total_kobo")
  minimumTotalKobo        Int?               @map("minimum_total_kobo")
  quotedAt                 DateTime?          @map("quoted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([customerId])
  @@map("orders")
}

enum IdempotencyState {
  processing
  completed

  @@map("idempotency_state")
}

/// The finished response for a client retry key, written in the same
/// transaction as the order it describes. Scoped to the actor and the
/// operation. A rollback leaves no row. A committed row is never replaced
/// or deleted.
model IdempotencyRecord {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId      String           @map("actor_id") @db.Uuid
  actor        User             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  scope        String           @db.VarChar(64)
  key          String           @db.VarChar(128)
  requestHash  String           @map("request_hash") @db.Char(64)
  state        IdempotencyState
  statusCode   Int?             @map("status_code")
  responseBody Json?            @map("response_body")
  lockedAt     DateTime         @default(now()) @map("locked_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt  DateTime?        @map("completed_at") @db.Timestamptz(3)

  @@unique([actorId, scope, key])
  @@map("idempotency_records")
}

/// Who did what to which record, on which request. Written in the same
/// transaction as the privileged change it describes.
model AuditEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String   @db.VarChar(64)
  targetType String   @map("target_type") @db.VarChar(64)
  targetId   String   @map("target_id") @db.VarChar(64)
  requestId  String   @map("request_id") @db.VarChar(64)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_events")
}
