# Copy to .env and fill in the blanks. Never commit .env.

# development | test | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Local PostgreSQL started by docker compose. Throwaway development values.
POSTGRES_USER=sparrow
POSTGRES_PASSWORD=sparrow
POSTGRES_DB=sparrow
# Host port for the compose database. Change it if 5433 is taken, and keep
# the port in DATABASE_URL and TEST_DATABASE_URL in sync.
POSTGRES_PORT=5433

# PostgreSQL connection URL used by the API and Prisma migrations.
DATABASE_URL=postgresql://sparrow:sparrow@localhost:5433/sparrow

# Database used by integration tests. Must end in _test; tests reset it.
# Created automatically by docker compose on first start.
TEST_DATABASE_URL=postgresql://sparrow:sparrow@localhost:5433/sparrow_test

# HS256 signing secret for access tokens, at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ISSUER=sparrow-api
JWT_AUDIENCE=sparrow-app

# Comma-separated list of browser origins allowed by CORS (Expo web dev server).
# Native mobile clients do not need an entry.
CORS_ORIGINS=http://localhost:8081

# Number of reverse-proxy hops in front of the API. 0 locally, 1 on Render.
# Too low makes every client share the proxy IP for rate limiting; too high
# lets clients spoof X-Forwarded-For.
TRUST_PROXY=0

# Default rate limit applied to /api routes, per client IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
