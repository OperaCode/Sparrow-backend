# Copy to .env and fill in the blanks. Never commit .env.

# development | test | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Local PostgreSQL started by docker compose. Throwaway development values.
POSTGRES_USER=sparrow
POSTGRES_PASSWORD=sparrow
POSTGRES_DB=sparrow
# Host port for the compose database. Change it if 5433 is taken, and keep
# the port in DATABASE_URL and TEST_DATABASE_URL in sync.
POSTGRES_PORT=5433

# PostgreSQL connection URL used by the API and Prisma migrations.
DATABASE_URL=postgresql://sparrow:sparrow@localhost:5433/sparrow

# Database used by integration tests. Must end in _test; tests reset it.
# Created automatically by docker compose on first start.
TEST_DATABASE_URL=postgresql://sparrow:sparrow@localhost:5433/sparrow_test

# HS256 signing secret for access tokens, at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ISSUER=sparrow-api
JWT_AUDIENCE=sparrow-app

# Comma-separated list of browser origins allowed by CORS (Expo web dev server).
# Native mobile clients do not need an entry.
CORS_ORIGINS=http://localhost:8081

# Number of reverse-proxy hops in front of the API. 0 locally, 1 on Render.
# Too low makes every client share the proxy IP for rate limiting; too high
# lets clients spoof X-Forwarded-For.
TRUST_PROXY=0

# Default rate limit applied to /api routes, per client IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Firebase Admin service account used to verify phone sign-in ID tokens.
# Base64 of the JSON key file from Firebase console > Project settings >
# Service accounts. Required in production; optional in development, where
# the token exchange endpoint returns 503 until it is set. Keep the key file
# outside the repository. Encode it with:
#   node -e "console.log(require('fs').readFileSync(process.argv[1]).toString('base64'))" path/to/key.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Session lifetimes. The refresh token TTL slides on every refresh and must
# not exceed the session max age, after which the user signs in again.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_SESSION_MAX_AGE_DAYS=90
# A Firebase ID token is only exchanged if its sign-in happened this recently.
AUTH_FIREBASE_MAX_AUTH_AGE_SECONDS=300

# Per-IP limits on the auth endpoints, applied on top of the default limit.
# Kept loose because mobile carriers put many users behind one IP.
AUTH_EXCHANGE_RATE_LIMIT_WINDOW_MS=900000
AUTH_EXCHANGE_RATE_LIMIT_MAX=30
AUTH_REFRESH_RATE_LIMIT_WINDOW_MS=900000
AUTH_REFRESH_RATE_LIMIT_MAX=30
